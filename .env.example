# ==============================================================
# AROHAN AI — Environment Configuration Template
# ==============================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT commit real secrets (.env) to version control.
# In production dashboards (Render, Railway, Vercel), set these as Environment Variables.

# --- Application Security ---
PROJECT_NAME="AROHAN AI"
# Generate a strong 32+ character random secret in production (e.g. `openssl rand -hex 32`)
SECRET_KEY="arohan-change-this-to-a-secure-random-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database Connection ---
# Option A (Local Development): Zero-setup SQLite (works out of the box)
DATABASE_URL="sqlite:///./arohan.db"
# Option B (Production PostgreSQL - Render, Neon, Supabase, Railway):
# Note: Both postgresql:// and postgres:// formats are automatically handled.
# DATABASE_URL="postgresql://arohan_user:your_password@your-db-host.render.com:5432/arohan_db"

# --- CORS Allowed Origins ---
# Comma-separated list or JSON array of frontend URLs permitted to call the backend.
# In local development:
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"
# In production (add your Vercel frontend domain):
# CORS_ORIGINS="https://your-arohan-app.vercel.app,http://localhost:5173"

# --- AI Provider Settings ---
# Options: "auto", "gemini", "openai", "rule_based"
# When set to "auto" and GEMINI_API_KEY is provided, uses Google Gemini 1.5 Flash.
# If left blank, Arohan automatically uses the built-in deterministic matching engine (demo mode).
AI_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# --- Regional Speech Provider (Bhashini - Govt of India) ---
# Optional: Leave blank to use browser Web Speech API with fallback
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
BHASHINI_PIPELINE_ID=""

# --- Frontend Deployment Variable (set in Vercel) ---
# VITE_API_URL="https://your-backend-app.onrender.com/api/v1"
# VITE_DEMO_MODE="true"
