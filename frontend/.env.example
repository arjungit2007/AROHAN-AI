# ==============================================================
# AROHAN AI — Frontend Environment Configuration
# ==============================================================

# Backend API URL
# In local development:
# - Leave blank or set to http://localhost:8000/api/v1
# In production (e.g. Vercel connecting to Render/Railway):
# - Set to your deployed backend HTTPS URL:
#   VITE_API_URL=https://your-arohan-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Demo Mode Indicator
# Set to "false" in full production to hide the hackathon demo banner
VITE_DEMO_MODE=true
